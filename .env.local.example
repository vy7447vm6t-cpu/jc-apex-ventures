# Google Workspace SMTP Configuration for JC Apex Ventures
# To generate a password: 
# 1. Log in to your Google Account (admin@jcapexv.com or Solis@jcapexv.com)
# 2. Go to Security -> 2-Step Verification -> App Passwords
# 3. Create an App Password for 'Mail' / 'JC Apex Website'
# 4. Paste the 16-character code below and rename this file to .env.local

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@jcapexv.com
SMTP_PASSWORD=your_16_digit_google_app_password
